{
  "expo": {
    "name": "elmonx-app",
    "slug": "elmonx-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elmonxapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.6",
    "updates": {
      "url": "https://u.expo.dev/3b3ce309-a3b1-4100-94d4-14f5217cb1b1"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.elmonx.app.dev",
      "associatedDomains": [
        "applinks:elmonx.com",
        "applinks:www.elmonx.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "This lets you take photos for your posts and view collectables in augmented reality using your camera.",
        "NSPhotoLibraryUsageDescription": "This lets you choose a photo for your profile picture and cover image.",
        "NSMicrophoneUsageDescription": "This lets you record videos of your collectables in 3D and AR with sound.",
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "rainbow",
          "uniswap",
          "zerion",
          "cbwallet",
          "safe",
          "imtokenv2",
          "okex",
          "bitkeep",
          "ledgerlive",
          "exodus",
          "argent"
        ],
        "CFBundleLocalizations": [
          "en",
          "ja",
          "es",
          "fr",
          "zh-Hant",
          "zh-Hans",
          "ko"
        ]
      }
    },
    "android": {
      "package": "com.elmonx.app.dev",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo-light.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0A0A0B",
            "image": "./assets/images/splash-logo-dark.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b3ce309-a3b1-4100-94d4-14f5217cb1b1"
      }
    },
    "owner": "yasirsaleem365",
    "locales": {
      "fr": "./src/i18n/native/fr.json",
      "ja": "./src/i18n/native/ja.json",
      "es": "./src/i18n/native/es.json",
      "zh-Hant": "./src/i18n/native/zh-Hant.json",
      "zh-Hans": "./src/i18n/native/zh-Hans.json",
      "ko": "./src/i18n/native/ko.json"
    }
  }
}
